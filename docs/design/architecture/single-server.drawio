"&lt;b&gt;Commons&lt;/b&gt;" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="435" width="36" height="36" as="geometry"/></mxCell><mxCell id="p28" value="&lt;b&gt;YouTube&lt;/b&gt;" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1300" y="435" width="36" height="36" as="geometry"/></mxCell><mxCell id="p29" value="&lt;b&gt;CAA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#DDDDDD;arcSize=6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="435" width="36" height="36" as="geometry"/></mxCell><mxCell id="p30" value="&lt;b&gt;Cover Art&lt;br&gt;Archive&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1178" y="474" width="80" height="30" as="geometry"/></mxCell><mxCell id="p31" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;장애·작업 실패 알림" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1095" y="610" width="36" height="36" as="geometry"/></mxCell><mxCell id="p32" value="① 주소 조회" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;dashed=1;" edge="1" parent="1" source="p4" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33" value="② HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.5;" edge="1" parent="1" source="p4" target="p9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=0.5;exitY=1;" edge="1" parent="1" source="p9" target="p10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=0.5;exitY=1;" edge="1" parent="1" source="p9" target="p11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p36" value="작업 등록" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.3;" edge="1" parent="1" source="p11" target="p16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p37" value="작업 처리" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=0;exitY=0.8;entryX=1;entryY=0.2;" edge="1" parent="1" source="p16" target="p13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="205"/><mxPoint x="755" y="418"/></Array></mxGeometry></mxCell><mxCell id="p38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.7;entryX=0;entryY=0.6;" edge="1" parent="1" source="p13" target="p18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p15" target="p24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p40" value="배포" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0;" edge="1" parent="1" source="p22" target="p9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p41" value="알림" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p20" target="p31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p42" value="읽는 법: 사용자는 도메인으로 서버 주소를 찾은 뒤 HTTPS로 서버 입구(Traefik)에 들어온다. 오래 걸리는 일(업로드 분석·곡 식별·추천)은 큐에 넣고 비동기 작업이 처리한다. 곡 설명과 추천 이유는 외부 근거 자료를 바탕으로 AI가 쓴다(RAG)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1340" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="gyeol-k3s" name="② k3s 내부"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value="② k3s 내부 구조 (Helm 차트 gyeol · values-single.yaml)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="p3" value="실선 = 요청 흐름, 점선 = 설정·비밀값 · 포트·파드 수·메모리 상한은 Helm 값 기준" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/></mxCell><mxCell id="p4" value="k3s 클러스터 (EC2 t4g.medium 1대)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#326CE5;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#326CE5;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1060" height="720" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Traefik&lt;/b&gt; (k3s 기본 Ingress 컨트롤러)&lt;br&gt;80 · 443 · Let's Encrypt TLS" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="40" height="40" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;Ingress gyeol&lt;/b&gt;&lt;br&gt;/ → gyeol-web:80&lt;br&gt;/api → gyeol-api:18080" style="sketch=0;html=1;dashed=0;whiteSpace=nowrap;strokeColor=#ffffff;aspect=fixed;pointerEvents=1;shape=mxgraph.kubernetes.icon;fontSize=11;fillColor=#326CE5;prIcon=ing;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="470" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;Traefik Middleware&lt;/b&gt;&lt;br&gt;ipAllowList: /admin, /api/admin (관리자 IP)&lt;br&gt;rateLimit: /api IP당 초당 20 · 순간 100" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8F0FE;strokeColor=#326CE5;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="108" width="320" height="64" as="geometry"/></mxCell><mxCell id="p8" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#326CE5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="195" height="175" as="geometry"/></mxCell><mxCell id="p9" value="gyeol-web :80" style="sketch=0;html=1;dashed=0;whiteSpace=nowrap;strokeColor=#ffffff;aspect=fixed;pointerEvents=1;shape=mxgraph.kubernetes.icon;fontSize=11;fillColor=#326CE5;prIcon=svc;labelPosition=right;verti