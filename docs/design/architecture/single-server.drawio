"1" source="p18" target="p42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="200"/><mxPoint x="1115" y="200"/><mxPoint x="1115" y="654"/></Array></mxGeometry></mxCell><mxCell id="p55" value="api·worker·백업 → SQS·S3·Bedrock·SES&lt;br&gt;(노드 IAM 역할, IMDSv2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.6;entryX=0;entryY=0.85;" edge="1" parent="1" source="p4" target="p37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p56" value="env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;dashed=1;strokeColor=#DD344C;fontColor=#DD344C;exitX=0.5;exitY=0;" edge="1" parent="1" source="p34" target="p14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p57" value="데이터" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.5;" edge="1" parent="1" source="p30" target="p32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="gyeol-rag" name="③ RAG 데이터 흐름"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value="③ RAG 데이터 흐름: 근거 있는 곡 설명과 추천 이유" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="p3" value="LLM이 지어내지 않게, 외부 근거 자료를 먼저 모아 DB에 두고 그 안에서만 쓰게 한다. 쓴 글은 인용한 근거가 실제로 있는지 검증한다. 곡 설명과 벡터는 곡마다 한 번만 만들어 모든 사용자가 같이 쓴다(전역 캐시). 근거: docs/l3-design.md, README 측정표" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1380" height="36" as="geometry"/></mxCell><mxCell id="p4" value="줄 1 · 곡 설명 만들기 (곡 식별이 끝나면 SQS enrich → worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FBF8;strokeColor=#01A88D;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#01A88D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1420" height="300" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;식별된 곡&lt;/b&gt;&lt;br&gt;MusicBrainz 원곡 ID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="120" height="70" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;① 근거 모으기 · fetcher&lt;/b&gt;&lt;br&gt;MusicBrainz 관계: 작곡·작사·편곡·프로듀서&lt;br&gt;위키백과 한·영·일 요약&lt;br&gt;Last.fm 위키 요약·태그&lt;br&gt;곡 → 음반 → 가수 순" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#01A88D;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="215" y="140" width="250" height="120" as="geometry"/></mxCell><mxCell id="p7" value="" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="420" y="145" width="32" height="32" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;knowledge_chunk&lt;/b&gt;&lt;br&gt;출처 URL · 라이선스 · 언어 · 짧은 본문" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=10;fillColor=#E6F4EA;strokeColor=#1E8E3E;" vertex="1" parent="1"><mxGeometry x="245" y="300" width="190" height="64" as="geometry"/></mxCell><mxCell id="p9" value="&lt;b&gt;② 곡 설명 생성 · Bedrock Haiku 4.5&lt;/b&gt;&lt;br&gt;모은 청크만 근거로 분위기·장르·보컬·시대&lt;br&gt;칸마다 근거 청크 ID · 근거 단위(곡/음반/가수)&lt;br&gt;근거가 없으면 &quot;근거 부족&quot;&lt;br&gt;가사 언급 금지" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#01A88D;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="270" height="120" as="geometry"/></mxCell><mxCell id="p10" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="725" y="145" width="32" height="32" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;검증&lt;/b&gt;&lt;br&gt;인용한 청크가&lt;br&gt;실제로 있어야 통과" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF7E6;strokeColor=#D97706;arcSize=6;" vertex="1" parent="1"><mxGeometry x="805" y="165" width="120" height="70" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;track_descriptor&lt;/b&gt;&lt;br&gt;곡별 칸 · 근거 · 신뢰도" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=10;fillColor=#E6F4EA;strokeColor=#1E8E3E;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="170" height="64" as="geometry"/></mxCell><mxCell id="p13" value="&lt;b&gt;③ 임베딩 · embed&lt;/b&gt;&lt;br&gt;곡 설명 문장 → 384차원 벡터&lt;br&gt;multilingual-e5-small · ONNX&lt;br&gt;문장당 8.4ms (PyTorch와 같은 벡터)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#01A88D;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="250" height="120" as="geometry"/></mxCell><mxCell id="p14" value="" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1165" y="145" width="32" height="32" as="geometry"/></mxCell><mxCell id="p15" value="&lt;b&gt;track_vector&lt;/b&gt;&lt;br&gt;pgvector · 곡 설명 임베딩" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=10;fillColor=#E6F4EA;strokeColor=#1E8E3E;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="190" height="64" as="geometry"/></mxCell><mxCell id="p16" value="" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1395" y="300" width="36" height="36" as="geometry"/></mxCell><mxCell id="p17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18" value="저장" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=0.5;exitY=1;" edge="1" parent="1" source="p6" target="p8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19" value="근거로 넣기" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="p8" target="p9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p9" target="p11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p21" value="통과" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=0.5;exitY=1;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p22" value="설명 문장" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="p12" target="p13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23" value="저장" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p13" target="p15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24" value="줄 2 · 추천과 이유 (SQS recommend → worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FF;strokeColor=#326CE5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#326CE5;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1420" height="250" as="geometry"/></mxCell><mxCell id="p25" value="&lt;b&gt;④ 취향 벡터&lt;/b&gt;&lt;br&gt;들은 곡 벡터의 가중 평균&lt;br&gt;가중치 log(1 + 재생 수)&lt;br&gt;장르·분위기·가수 상위" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#326CE5;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="230" height="150" as="geometry"/></mxCell><mxCell id="p26" value="&lt;b&gt;⑤ 후보 50곡 (검색)&lt;/b&gt;&lt;br&gt;pgvector 이웃 30곡 (&lt;=&gt; 코사인 거리)&lt;br&gt;+ Last.fm 비슷한 곡·비슷한 가수 인기곡&lt;br&gt;들은 곡 제외 · 새 후보는 줄 1을 거침" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#326CE5;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="260" height="150" as="geometry"/></mxCell><mxCell id="p27" value="&lt;b&gt;⑥ 점수&lt;/b&gt;&lt;br&gt;0.5 × 취향 유사도&lt;br&gt;+ 0.3 × Last.fm 유사도&lt;br&gt;+ 0.2 × 같은 작곡가·프로듀서&lt;br&gt;가수당 최대 2곡" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#326CE5;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="480" width="250" height="150" as="geometry"/></mxCell><mxCell id="p28" value="&lt;b&gt;⑦ 재정렬과 이유 · Bedrock&lt;/b&gt;&lt;br&gt;상위 50곡 + 각 곡 설명·근거 청크를 넣고&lt;br&gt;LLM이 20곡을 고르고 이유를 씀&lt;br&gt;검증: 후보 번호·청크 번호가 맞아야 통과&lt;br&gt;모자라면 점수 순으로 채움" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#326CE5;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="890" y="480" width="280" height="150" as="geometry"/></mxCell><mxCell id="p29" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1125" y="485" width="32" height="32" as="geometry"/></mxCell><mxCell id="p30" value="&lt;b&gt;결과 화면&lt;/b&gt;&lt;br&gt;추천 20곡 · 표지&lt;br&gt;이유 + 출처 링크&lt;br&gt;좋아요 · 별로 · &quot;이유가 틀림&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1200" y="495" width="240" height="120" as="geometry"/></mxCell><mxCell id="p31" value="들은 곡 벡터" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p15" target="p25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="415"/><mxPoint x="175" y="415"/></Array></mxGeometry></mxCell><mxCell id="p32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p25" target="p26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p26" target="p27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p27" target="p28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;" edge="1" parent="1" source="p28" target="p30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p36" value="곡 설명·근거" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#7A8696;dashed=1;strokeColor=#01A88D;fontColor=#01A88D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p12" target="p28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="405"/><mxPoint x="1030" y="405"/></Array></mxGeometry></mxCell><mxCell id="p37" value="평가 · RAG 켬/끔 블라인드 비교" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F3FF;strokeColor=#7C3AED;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#7C3AED;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="690" height="160" as="geometry"/></mxCell><mxCell id="p38" value="· 추천 20곡 중 절반은 근거 자료 없이 이유를 쓴다(NORAG). 사용자는 어느 쪽인지 모른 채 평가한다.&lt;br&gt;· 평가 항목: 좋아요·별로, &quot;이유가 틀림&quot; 체크&lt;br&gt;· 운영 첫 배포는 업로드 분석까지만 자동(autoRecommend=false). 추천과 이 흐름은 추천 기능을 켤 때 돈다." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="60" y="745" width="660" height="120" as="geometry"/></mxCell><mxCell id="p39" value="측정 (로컬, README 측정표)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FAF3;strokeColor=#1E8E3E;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1E8E3E;arcSize=3;" vertex="1" parent="1"><mxGeometry x="760" y="710" width="700" height="160" as="geometry"/></mxCell><mxCell id="p40" value="&lt;table style=&quot;font-size:11px;border-collapse:collapse&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;곡 설명의 근거 일치율&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RAG 켬 &lt;b&gt;80%&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RAG 끔 13%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;추천 이유 근거 일치&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Haiku 4.5 19/20&lt;/td&gt;&lt;td&gt;Sonnet 4.6 20/20 (비용 약 3배)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;추천 좋아요 (첫 측정)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RAG 켬 7/10&lt;/td&gt;&lt;td&gt;끔 8/10 · 표본이 작아 차이 없음&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;임베딩 속도&lt;/b&gt;&lt;/td&gt;&lt;td&gt;문장당 8.4ms&lt;/td&gt;&lt;td&gt;ONNX fp32&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="745" width="660" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="gyeol-single" name="④ 배포·운영 (상세)">
