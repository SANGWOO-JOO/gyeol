<mxfile host="app.diagrams.net">
  <diagram id="gyeol-overview" name="① 전체 개요"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1420" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value="결(gyeol) 시스템 개요" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p3" value="유튜브 뮤직 청취 기록을 분석하고, 친구들과 음악 방(취향 지도)을 만드는 서비스 · 서버 1대(k3s) + AWS 관리형 서비스 · 운영비 월 약 17.5달러(부가세 포함, 추정) · 자세한 구조는 ② k3s 내부, ④ 배포·운영 페이지" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="36" as="geometry"/></mxCell><mxCell id="p4" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#00A4A6;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="48" height="48" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;사용자&lt;/b&gt;&lt;br&gt;웹 · 휴대폰" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="382" width="110" height="34" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;ourgyeol.com&lt;/b&gt;&lt;br&gt;도메인 (Cloudflare DNS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDEBD3;strokeColor=#F38020;arcSize=6;" vertex="1" parent="1"><mxGeometry x="170" y="210" width="150" height="60" as="geometry"/></mxCell><mxCell id="p7" value="AWS 서울 리전" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="660" height="600" as="geometry"/></mxCell><mxCell id="p8" value="EC2 서버 1대 · k3s (경량 쿠버네티스)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFF7ED;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;" vertex="1" parent="1"><mxGeometry x="395" y="150" width="340" height="530" as="geometry"/></mxCell><mxCell id="p9" value="&lt;b&gt;입구 (Traefik)&lt;/b&gt;&lt;br&gt;HTTPS · 경로 나누기 · 요청 수 제한" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="40" height="40" as="geometry"/></mxCell><mxCell id="p10" value="&lt;b&gt;웹 화면&lt;/b&gt;&lt;br&gt;React (Nginx로 제공)" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="445" y="300" width="40" height="40" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;Spring Boot · Kotlin" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="625" y="300" width="40" height="40" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;DB&lt;/b&gt;&lt;br&gt;PostgreSQL + pgvector" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="445" y="410" width="40" height="40" as="geometry"/></mxCell><mxCell id="p13" value="&lt;b&gt;비동기 작업&lt;/b&gt;&lt;br&gt;분석·곡 식별·추천" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="625" y="410" width="40" height="40" as="geometry"/></mxCell><mxCell id="p14" value="&lt;b&gt;임베딩&lt;/b&gt;&lt;br&gt;문장 → 벡터" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="445" y="520" width="40" height="40" as="geometry"/></mxCell><mxCell id="p15" value="&lt;b&gt;외부 데이터 수집&lt;/b&gt;&lt;br&gt;음악 정보 API 호출" style="image;aspect=fixed;html=1;imageAspect=0;imageBackground=#FFFFFF;spacing=2;fontSize=11;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="625" y="520" width="40" height="40" as="geometry"/></mxCell><mxCell id="p16" value="&lt;b&gt;작업 큐&lt;/b&gt; (SQS)&lt;br&gt;업로드 분석·곡 식별 등 단계별 큐" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="775" y="170" width="44" height="44" as="geometry"/></mxCell><mxCell id="p17" value="&lt;b&gt;파일 저장&lt;/b&gt; (S3)&lt;br&gt;업로드·앨범 표지·가수 사진·DB 백업" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="775" y="275" width="44" height="44" as="geometry"/></mxCell><mxCell id="p18" value="&lt;b&gt;AI&lt;/b&gt; (Bedrock · Claude Haiku)&lt;br&gt;곡 설명·추천 이유 (RAG)" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="775" y="380" width="44" height="44" as="geometry"/></mxCell><mxCell id="p19" value="&lt;b&gt;메일&lt;/b&gt; (SES)&lt;br&gt;인증 메일" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="775" y="470" width="44" height="44" as="geometry"/></mxCell><mxCell id="p20" value="&lt;b&gt;모니터링&lt;/b&gt; (CloudWatch)&lt;br&gt;알람 → Slack" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;whiteSpace=nowrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="775" y="600" width="44" height="44" as="geometry"/></mxCell><mxCell id="p21" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#24292F;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacin