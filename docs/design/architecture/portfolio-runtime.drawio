<mxfile host="app.diagrams.net"><diagram id="gyeol-portfolio-runtime" name="결 실행 구조 (포트폴리오)"><mxGraphModel dx="1600" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r2" value="&lt;b&gt;결(gyeol) 실행 구조&lt;/b&gt; — 노래 담기부터 곡 식별·가수 준비·코드 맞추기까지 (gyeol.blog 운영)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1540" height="30" as="geometry"/></mxCell><mxCell id="r3" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#4B5563;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="56" height="56" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;사용자&lt;/b&gt;" style="text;html=1;fontSize=15;align=center;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="14" y="350" width="88" height="24" as="geometry"/></mxCell><mxCell id="r5" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;웹&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;React · Vite&lt;br&gt;방 · 지도 · 노래 담기&lt;br&gt;PC · 모바일&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="115" y="250" width="205" height="130" as="geometry"/></mxCell><mxCell id="r6" value="" style="image;aspect=fixed;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="127" y="293" width="44" height="44" as="geometry"/></mxCell><mxCell id="r7" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;API&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;Spring Boot · Kotlin&lt;br&gt;방 · 검색 · 노래 담기&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="375" y="250" width="205" height="130" as="geometry"/></mxCell><mxCell id="r8" value="" style="image;aspect=fixed;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="387" y="293" width="44" height="44" as="geometry"/></mxCell><mxCell id="r9" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;SQS 작업 큐&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;+ 실패 큐&lt;br&gt;3번 실패하면 실패로 표시&lt;br&gt;화면이 멈추지 않음&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFDDC2;strokeColor=#8A5A2B;strokeWidth=2.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="215" height="130" as="geometry"/></mxCell><mxCell id="r10" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="652" y="293" width="44" height="44" as="geometry"/></mxCell><mxCell id="r11" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;worker&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;Kotlin · 단계별 소비&lt;br&gt;곡 식별 · 표지 · 선물&lt;br&gt;가수 준비 · 코드 맞추기&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFDDC2;strokeColor=#8A5A2B;strokeWidth=2.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="915" y="250" width="205" height="130" as="geometry"/></mxCell><mxCell id="r12" value="" style="image;aspect=fixed;html=1;imageAspect=0;image=data:image/svg+xml,;illust=1;" vertex="1" parent="1"><mxGeometry x="920" y="286" width="58" height="58" as="geometry"/></mxCell><mxCell id="r13" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;① 외부 수집 모듈&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;external-fetcher&lt;br&gt;외부 호출을 한 곳에 모음&lt;br&gt;속도 제한 · 캐시&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFDDC2;strokeColor=#8A5A2B;strokeWidth=2.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170" y="50" width="235" height="135" as="geometry"/></mxCell><mxCell id="r14" value="" style="image;aspect=fixed;html=1;imageAspect=0;image=data:image/svg+xml,;illust=1;" vertex="1" parent="1"><mxGeometry x="1175" y="88" width="58" height="58" as="geometry"/></mxCell><mxCell id="r15" value="&lt;div style=&quot;font-size:15px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;외부 음악 데이터&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.5&quot;&gt;MusicBrainz&lt;br&gt;Last.fm&lt;br&gt;위키백과&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F4F6;strokeColor=#9CA3AF;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="62" width="150" height="111" as="geometry"/></mxCell><mxCell id="r16" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;② 임베딩&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;Python · ONNX&lt;br&gt;multilingual-e5-small&lt;br&gt;가수 설명 → 384차원 벡터&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170" y="260" width="235" height="120" as="geometry"/></mxCell><mxCell id="r17" value="" style="image;aspect=fixed;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1182" y="298" width="44" height="44" as="geometry"/></mxCell><mxCell id="r18" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;③ Bedrock · Claude Haiku&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;근거 자료 안에서만 가수 설명, 코드 맞추기 이유&lt;br&gt;근거 번호가 실제로 있는지 검증&lt;br&gt;거절문·음악 낱말 없는 설명은 버림&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFDDC2;strokeColor=#8A5A2B;strokeWidth=2.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170" y="455" width="340" height="135" as="geometry"/></mxCell><mxCell id="r19" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1182" y="500" width="44" height="44" as="geometry"/></mxCell><mxCell id="r20" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margin-bottom:4px&quot;&gt;PostgreSQL&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#374151;line-height:1.35&quot;&gt;pgvector (가수 벡터 이웃 검색)&lt;br&gt;pg_trgm (초성·오타 곡 검색)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="430" y="495" width="280" height="120" as="geometry"/></mxCell><mxCell id="r21" value="" style="image;aspect=fixed;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="442" y="533" width="44" height="44" as="geometry"/></mxCell><mxCell id="r22" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F2937;margi