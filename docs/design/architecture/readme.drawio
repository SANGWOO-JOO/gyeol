Y=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="k318" target="k316"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="445.0"/><mxPoint x="400" y="445.0"/></Array></mxGeometry></mxCell><mxCell id="k328" value="배포할 때마다 — gyeol-deploy &amp;lt;태그&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7EF;strokeColor=#ED7100;fontSize=13;fontStyle=1;dashed=0;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1230" y="70.0" width="390" height="560" as="geometry"/></mxCell><mxCell id="k329" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1272.0" y="122.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="k330" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;v* 태그 → 검사·이미지(GHCR)&lt;br&gt;OIDC → SSM send-command&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="114.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k331" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1272.0" y="188.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="k332" value="&lt;b&gt;0. 태그 확인&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;v1.2.3 · v1.2.3-rc.1 형식&lt;br&gt;(자동 배포는 하이픈 태그 제외)&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="180.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k333" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k329" target="k331"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k334" value="" style="aspect=fixed;html=1;shape=mxgraph.kubernetes.icon;prIcon=job;fillColor=#326CE5;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1271.0" y="253.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="k335" value="&lt;b&gt;1. 배포 전 백업&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;CronJob·DB가 있을 때만 predeploy Job&lt;br&gt;(첫 배포는 건너뜀) · 실패하면 중단&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="246.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k336" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k331" target="k334"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k337" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1272.0" y="320.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="k338" value="&lt;b&gt;2. 차트 받기&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;그 태그의 저장소 tar.gz&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="312.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k339" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k334" target="k337"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k340" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.parameter_store;" vertex="1" parent="1"><mxGeometry x="1272" y="386.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="k341" value="&lt;b&gt;3. 비밀값&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Parameter Store /gyeol/prod/*&lt;br&gt;→ Secret gyeol-secrets&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="378.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k342" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k337" target="k340"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k343" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1272.0" y="452.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="k344" value="&lt;b&gt;4. helm upgrade --install&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;values + values-single + values-prod&lt;br&gt;image.tag=태그 · --wait&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="444.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k345" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k340" target="k343"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k346" value="" style="aspect=fixed;html=1;shape=mxgraph.kubernetes.icon;prIcon=deploy;fillColor=#326CE5;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1271.0" y="517.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="k347" value="&lt;b&gt;5. rollout 확인&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Deployment 5개 완료 대기&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="510.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k348" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k343" target="k346"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k349" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1272.0" y="584.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="k350" value="&lt;b&gt;6. 밖에서 확인 (Actions)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;웹 응답 · /api 없는 방 404&lt;br&gt;자동 롤백 없음 (실패 시 사람이 판단)&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="576.0" width="280" height="52" as="geometry"/></mxCell><mxCell id="k351" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="k346" target="k349"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k352" value="적용" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="k343" target="k31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k353" value="&lt;b&gt;운영 특성&lt;/b&gt;&lt;br&gt;• 스팟 회수 → EC2 stop → 자리가 나면 자동 시작 → k3s·Pod가 스스로 다시 뜸 (데이터는 EBS에 남음, 11-17 실제로 5번 겪음)&lt;br&gt;• 값 파일 3겹: values.yaml(공통) → values-single.yaml(단일 서버) → /etc/gyeol/values-prod.yaml(서버 전용, Terraform이 만듦). 로컬 k3d는 values-local.yaml로 같은 차트를 씀&lt;br&gt;• 이미지는 GHCR 공개 이미지(linux/arm64)라 ECR 비용 없음 · 비밀값은 Parameter Store에만 두고 저장소·이미지에 넣지 않음&lt;br&gt;• 서버가 한 대라 Pod 수를 늘려도 CPU가 늘지 않아 모두 replicas 1, HPA 끔 · 메모리 4GiB + swap 2GiB&lt;br&gt;• PVC 10Gi는 루트 EBS(gp3 암호화 30GiB) 안의 요청량 · user_data를 고쳐도 기존 서버에는 반영되지 않음 (서버를 새로 만들어야 함)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="650.0" width="1600" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="terraform" id="terraform"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="800" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="te1" value="&lt;b&gt;맥북&lt;/b&gt;&lt;br&gt;terraform apply" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="60" height="60" as="geometry"/></mxCell><mxCell id="te2" value="&lt;b&gt;상태 파일&lt;/b&gt;&lt;br&gt;S3 버킷 (backend.hcl)&lt;br&gt;use_lockfile 잠금&lt;br&gt;계정 ID는 저장소 밖" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="te3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#888888;dashed=1;exitX=0;exitY=0.5;entryX=0.2;entryY=0;" edge="1" parent="1" source="te1" target="te2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="150"/><mxPoint x="30" y="250"/><mxPoint x="60" y="250"/></Array></mxGeometry></mxCell><mxCell id="te4" value="tfstate" style="text;html=1;fontSize=11;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="36" y="262" width="80" height="20" as="geometry"/></mxCell><mxCell id="te5" value="① base — 거의 바뀌지 않는 공용 자원 (현재 설정 41개, 비용 거의 0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3ECFA;strokeColor=#7B42BC;fontSize=13;fontStyle=1;dashed=0;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="560" height="300" as="geometry"/></mxCell><mxCell id="te6" value="&lt;b&gt;SQS 20&lt;/b&gt;&lt;br&gt;큐 10 + DLQ 10" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te7" value="&lt;b&gt;S3 3&lt;/b&gt;&lt;br&gt;업로드·표지·백업&lt;br&gt;수명 주기·암호화" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te8" value="&lt;b&gt;SES&lt;/b&gt;&lt;br&gt;gyeol.blog DKIM&lt;br&gt;MAIL FROM·수신 거부" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te9" value="&lt;b&gt;Budget&lt;/b&gt;&lt;br&gt;월 예산 알림 메일" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te10" value="&lt;b&gt;IAM 정책 app&lt;/b&gt;&lt;br&gt;SQS·S3·Bedrock·SES" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="48" height="48" as="geometry"/></mxCell><mxCell id="te11" value="• S3 업로드 → parse 큐 알림 연결&lt;br&gt;• 큐 이름 gyeol-parse 등 (Helm 기본값과 같음)&lt;br&gt;• 출력: 버킷 이름·정책 ARN → single이 읽음" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;fontSize=11;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="390" height="70" as="geometry"/></mxCell><mxCell id="te12" value="② single — 서버 한 대 (지울 때는 이것만 destroy, 루트 EBS는 남아 직접 삭제)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=13;fontStyle=1;dashed=0;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="780" height="300" as="geometry"/></mxCell><mxCell id="te13" value="&lt;b&gt;EC2 t4g.medium&lt;/b&gt;&lt;br&gt;스팟 persistent·stop&lt;br&gt;2b (tfvars, 기본값 2d)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te14" value="&lt;b&gt;EIP&lt;/b&gt;&lt;br&gt;고정 IP" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_ip_address;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te15" value="&lt;b&gt;보안 그룹&lt;/b&gt;&lt;br&gt;80·443만&lt;br&gt;SSH 없음" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;" vertex="1" parent="1"><mxGeometry x="1130" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te16" value="&lt;b&gt;gyeol-server 역할&lt;/b&gt;&lt;br&gt;인스턴스 프로필&lt;br&gt;app 정책 + SSM" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te17" value="&lt;b&gt;gyeol-deploy 역할&lt;/b&gt;&lt;br&gt;GitHub OIDC 신뢰 (production)&lt;br&gt;이 서버에만 send-command" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="te18" value="• 기본 VPC의 퍼블릭 서브넷 사용 (NAT 없음)&lt;br&gt;• user-data = user-data.sh.tftpl + values-prod.yaml.tftpl + gyeol-deploy.sh 를 채워 EC2에 전달&lt;br&gt;• 출력: public_ip·instance_id → GitHub Variables (AWS_DEPLOY_ROLE_ARN·SERVER_INSTANCE_ID)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;fontSize=11;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="870" y="270" width="720" height="70" as="geometry"/></mxCell><mxCell id="te19" value="① apply base (먼저)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#7B42BC;strokeWidth=1.5;exitX=1;exitY=0.6;entryX=0;entryY=0.3;" edge="1" parent="1" source="te1" target="te5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="te20" value="② apply single" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#7B42BC;strokeWidth=1.5;exitX=1;exitY=0.3;entryX=0.5;entryY=0;" edge="1" parent="1" source="te1" target="te13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="138"/><mxPoint x="140" y="62"/><mxPoint x="894" y="62"/></Array></mxGeometry></mxCell><mxCell id="te21" value="③ EC2 첫 부팅 때 user-data 자동 실행 (서버 안 root, 로그 /var/log/gyeol-user-data.log)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7EF;strokeColor=#ED7100;fontSize=13;fontStyle=1;dashed=0;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1600" height="160" as="geometry"/></mxCell><mxCell id="te22" value="&lt;b&gt;시간대·swap 2GB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;메모리 4GiB 여유가 작아&lt;br&gt;OOM 방지&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="235" height="90" as="geometry"/></mxCell><mxCell id="te23" value="&lt;b&gt;AWS CLI·jq&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;배포 때 Parameter Store 읽기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="302" y="465" width="235" height="90" as="geometry"/></mxCell><mxCell id="te24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="te22" target="te23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="te25" value="&lt;b&gt;Traefik 설정 먼저 놓기&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Let&#x27;s Encrypt HTTP-01&lt;br&gt;HTTP → HTTPS·방문자 IP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="564" y="465" width="235" height="90" as="geometry"/></mxCell><mxCell id="te26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="te23" target="te25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="te27" value="&lt;b&gt;k3s 설치&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;버전 고정 · 시작할 때 설정 읽음&lt;br&gt;Traefik·local-path·CoreDNS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="826" y="465" width="235" height="90" as="geometry"/></mxCell><mxCell id="te28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="te25" target="te27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="te29" value="&lt;b&gt;Helm 설치&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;버전 고정 (arm64)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1088" y="465" width="235" height="90" as="geometry"/></mxCell><mxCell id="te30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="te27" target="te29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="te31" value="&lt;b&gt;/etc/gyeol/&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;values-prod.yaml·github-repo&lt;br&gt;/usr/local/bin/gyeol-deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1350" y="465" width="235" height="90" as="geometry"/></mxCell><mxCell id="te32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="te29" target="te31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="te33" value="첫 부팅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=0.55;entryY=0;" edge="1" parent="1" source="te13" target="te21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="154"/><mxPoint x="825" y="400"/><mxPoint x="900" y="400"/></Array></mxGeometry></mxCell><mxCell id="te34" value="&lt;b&gt;④ 사람이 한 번 하는 일 (Terraform 밖)&lt;/b&gt;&lt;br&gt;• 비밀값 넣기: aws ssm put-parameter /gyeol/prod/DB_PASSWORD·ADMIN_TOTP_KEY·LASTFM_API_KEY·YOUTUBE_API_KEY (SecureString)&lt;br&gt;• DNS: Porkbun A 레코드 gyeol.blog → EIP&lt;br&gt;• GitHub: Environment production + Variables 3개 (terraform output github_variables)&lt;br&gt;• 계정에 GitHub OIDC 공급자가 있어야 함 (Terraform은 참조만) · SES DNS 인증·프로덕션 승인 신청 · Bedrock Stable Image Core 접근(선물 그림)&lt;br&gt;• 첫 태그 push → gyeol-deploy가 앱 Pod를 처음 올림 → 지도·곡 데이터 옮기기(D4)&lt;br&gt;• 다시 만들 때: destroy → apply 하면 ③이 다시 실행됨. 스팟 stop→start는 같은 서버라 ③을 다시 하지 않음" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1000" height="165" as="geometry"/></mxCell><mxCell id="te35" value="&lt;b&gt;결과: 빈 k3s 서버&lt;/b&gt;&lt;br&gt;• k3s·Traefik(인증서 발급 설정)·Helm·배포 스크립트까지 준비됨&lt;br&gt;• 실제 인증서는 첫 배포로 Ingress가 생길 때 발급&lt;br&gt;• 우리 앱 Pod(web·api·worker…)는 아직 없음&lt;br&gt;• 이후 배포는 매번 태그 push → gyeol-deploy만 실행" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F0FA;strokeColor=#1F6FB2;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1050" y="610" width="570" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="erd" id="erd"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="er1" value="&lt;div style=&#x27;background:#7A3EB1;color:#fff;font-weight:bold;padding:5px 8px;text-align:left&#x27;&gt;room&lt;/div&gt;&lt;div style=&#x27;text-align:left;padding:1px 8px;border-top:1px solid #eee&#x27;&gt;🔑 &lt;b&gt;id&lt;/b&gt; &lt;span style=&#x27;color:#999&#x27;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&#x27;text-align:left;padding:1px 8px;border-top:1px solid #eee&#x27;&gt;public_id &lt;span style=&#x27;color:#999&#x27;&gt;초대 링크&lt;/span&gt;&lt;/div&gt;&lt;div style=&#x27;text-align:left;padding:1px 8px;border-top:1px solid #eee&#x27;&gt;name &lt;span style=&#x27;color:#999&#x27;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&#x27;text-align:left;padding:1px 8px;border-top:1px solid #eee&#x27;&gt;status &lt;span style=&#x27;color:#999&#x27;&gt;ACTIVE·HIDDEN·CLOSED&lt;/span&gt;&lt;/div&gt;&lt;div style=&#x27;text-align:left;padding:1px 8px;border-top:1px solid #eee&#x27;&gt;hidden_at · purge_at &lt;span style=&#x