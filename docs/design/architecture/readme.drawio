f;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;jumpStyle=arc;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="sy29" target="sy31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="780"/><mxPoint x="718" y="780"/></Array></mxGeometry></mxCell><mxCell id="sy50" value="SSM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;jumpStyle=arc;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="sy31" target="sy22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1173" y="830"/></Array></mxGeometry></mxCell><mxCell id="sy51" value="helm upgrade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;jumpStyle=arc;exitX=0;exitY=0.5;entryX=1;entryY=0.9;" edge="1" parent="1" source="sy22" target="sy6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="518"/><mxPoint x="1100" y="608"/></Array></mxGeometry></mxCell><mxCell id="sy52" value="&lt;b&gt;선 구분&lt;/b&gt;&lt;br&gt;— 실선: 요청·처리 흐름&lt;br&gt;- - 회색 점선: 백업&lt;br&gt;- - 주황 점선: 배포 (태그 push → 서버)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;fontSize=11;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1370" y="520" width="250" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="pipeline" id="pipeline"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="580" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pi1" value="① RAG 1 · 가수 설명 — 가수 ID로 근거 수집 → LLM 설명 → 임베딩 → 음악 은하 지도" style="text;html=1;fontSize=15;fontStyle=1;align=left;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="26" as="geometry"/></mxCell><mxCell id="pi2" value="&lt;b&gt;문서 수집&lt;/b&gt;&lt;br&gt;Wikipedia·Last.fm&lt;br&gt;MusicBrainz" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="44.0" y="79.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi3" value="&lt;b&gt;external-fetcher&lt;/b&gt;&lt;br&gt;외부 호출 한 곳&lt;br&gt;속도 제한·캐시" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="190.0" y="85.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="pi4" value="&lt;b&gt;LLM 설명&lt;/b&gt;&lt;br&gt;Claude Haiku 4.5&lt;br&gt;근거 안에서만 서술" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="334.0" y="79.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi5" value="&lt;b&gt;출력 검증&lt;/b&gt;&lt;br&gt;거절문·음악 낱말 없는&lt;br&gt;설명은 버림" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="468.0" y="73.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="pi6" value="&lt;b&gt;임베딩&lt;/b&gt;&lt;br&gt;e5-small · 384차원&lt;br&gt;원문 0.5 + 설명 0.5&lt;br&gt;이웃 적중 43%&lt;br&gt;(원문만 32%)" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="604.0" y="79.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi7" value="&lt;b&gt;pgvector · HNSW&lt;/b&gt;&lt;br&gt;코사인 이웃 검색&lt;br&gt;(지도 배치용)" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="754.0" y="79.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi8" value="&lt;b&gt;음악 은하 지도&lt;/b&gt;&lt;br&gt;1,403명 UMAP 2D&lt;br&gt;나머지·새 가수는&lt;br&gt;이웃 5명 평균 자리" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="894.0" y="69.0" width="72" height="72" as="geometry"/></mxCell><mxCell id="pi9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi2" target="pi3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi3" target="pi4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi4" target="pi5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi5" target="pi6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi6" target="pi7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi7" target="pi8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi19" value="&lt;b&gt;코드 맞추기&lt;/b&gt;" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="309" width="72" height="72" as="geometry"/></mxCell><mxCell id="pi20" value="&lt;b&gt;점수는 코드&lt;/b&gt;&lt;br&gt;장르 40·거리 30&lt;br&gt;가수 20·곡 10" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,PHN2ZyBmaWxsPSIjN0Y1MkZGIiByb2xlPSJpbWciIHZpZXdCb3g9IjAgMCAyNCAyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48dGl0bGU+S290bGluPC90aXRsZT48cGF0aCBkPSJNMjQgMjRIMFYwaDI0TDEyIDEyWiIvPjwvc3ZnPg==;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="254" y="319" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi21" value="&lt;b&gt;이유 LLM&lt;/b&gt;&lt;br&gt;Claude Haiku 4.5&lt;br&gt;근거 번호 인용" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="674" y="319" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi19" target="pi20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi20" target="pi51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi50" value="② RAG 2 · 코드 맞추기 이유 — 점수는 코드, 이유는 저장된 가수 설명을 근거로" style="text;html=1;fontSize=15;fontStyle=1;align=left;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="700" height="26" as="geometry"/></mxCell><mxCell id="pi51" value="&lt;b&gt;근거 첨부&lt;/b&gt;&lt;br&gt;겹친 가수의 설명·근거 번호&lt;br&gt;(RAG 1 결과를 DB에서)" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="464" y="319" width="52" height="52" as="geometry"/></mxCell><mxCell id="pi52" value="&lt;b&gt;번호 검증&lt;/b&gt;&lt;br&gt;유효 번호 없으면 버림&lt;br&gt;실패 큐 → 이유 없이 완료" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="884" y="313" width="64" height="64" as="geometry"/></mxCell><mxCell id="pi53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi51" target="pi21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="pi21" target="pi52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pi32" value="&lt;b&gt;공통 장치&lt;/b&gt;&lt;br&gt;• 구조화 출력: 텍스트 LLM은 Bedrock Converse + tool 스키마로 형식을 받고, 내용은 코드가 다시 검증&lt;br&gt;• 비동기: 사용자 요청의 무거운 작업은 SQS 큐로 넘겨 worker가 처리 (3번 실패하면 DLQ) · 지도 처음 만들기는 배치 도구&lt;br&gt;• 비용: LLM 호출의 모델·토큰·지연을 llm_call에 기록 · 선물 그림 하루 한도 · 기본 fake 모드" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#BBBBBB;fontSize=12;fontStyle=0;dashed=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="465" width="1010" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="llm-assist" id="llm-assist"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="240" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="la15" value="LLM 보조 작업 — 근거 검색 없이, 계산·판정은 코드가 하고 LLM은 정리와 묘사만" style="text;html=1;fontSize=15;fontStyle=1;align=left;fontColor=#7A3EB1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="26" as="geometry"/></mxCell><mxCell id="la16" value="&lt;b&gt;곡 식별&lt;/b&gt;&lt;br&gt;규칙으로 원곡 찾기" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="44.0" y="79.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="la17" value="&lt;b&gt;LLM 다른 표기&lt;/b&gt;&lt;br&gt;못 찾을 때만&lt;br&gt;다른 표기로 재검색" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientCol