# 로컬 개발용 환경 변수 예시. 복사해서 .env로 쓴다 (.env는 커밋하지 않는다).
# 기본값은 application.yml에 있으므로 바꿀 것만 적으면 된다.

# PostgreSQL (local/compose.yaml)
DB_URL=jdbc:postgresql://localhost:15432/gyeol
DB_USER=gyeol
DB_PASSWORD=gyeol

# MusicBrainz·위키백과 User-Agent 연락처
GYEOL_CONTACT=https://github.com/SANGWOO-JOO

# 워커 역할 (L1은 parse만)
WORKER_ROLE=parse
