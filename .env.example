# 로컬 개발용 환경 변수 예시. 복사해서 .env로 쓴다 (.env는 커밋하지 않는다).
# 기본값은 application.yml에 있으므로 바꿀 것만 적으면 된다.

# PostgreSQL (local/compose.yaml)
DB_URL=jdbc:postgresql://localhost:15432/gyeol
DB_USER=gyeol
DB_PASSWORD=gyeol

# MusicBrainz·위키백과 User-Agent 연락처
GYEOL_CONTACT=https://github.com/SANGWOO-JOO

# Last.fm API 키 (곡 고르기 검색). 비어 있으면 검색만 503. https://www.last.fm/api/account/create 에서 발급
LASTFM_API_KEY=

# 워커 역할 (쉼표로 여러 개: parse, identify, cover, enrich)
WORKER_ROLE=parse,identify,cover,enrich,recommend

# YouTube Data API 키 (일반 영상 음악 판정, L2-3b). 비어 있으면 판정을 건너뛴다
YOUTUBE_API_KEY=

# LLM 제목 정리 (L2-3a): fake(기본, 비용 없음) | bedrock(맥북 AWS 자격 증명으로 Bedrock 호출, 비용 발생)
LLM_MODE=fake
